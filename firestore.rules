rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperadmin() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/superadmin/$(request.auth.uid));
    }

    function isBusinessOwner(bid) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/businesses/$(bid)) &&
             get(/databases/$(database)/documents/businesses/$(bid)).data.iletisim.sahipUid == request.auth.uid;
    }

    function isBusinessStaff(bid) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/businesses/$(bid)/staff/$(request.auth.uid));
    }

    function hasPermission(bid, permission) {
      return isBusinessStaff(bid) &&
             get(/databases/$(database)/documents/businesses/$(bid)/staff/$(request.auth.uid)).data.yetkiler[permission] == true;
    }

    function isCustomer(cid) {
      return isAuthenticated() && request.auth.uid == cid;
    }

    function createsOwnBusiness(bid) {
      return isAuthenticated() &&
             request.resource.data.iletisim.sahipUid == request.auth.uid &&
             request.resource.data.status == 'deneme' &&
             request.resource.data.plan.denemeMi == true &&
             (!('ownerUid' in request.resource.data) || request.resource.data.ownerUid == request.auth.uid) &&
             (!('sahipUid' in request.resource.data) || request.resource.data.sahipUid == request.auth.uid) &&
             (!('id' in request.resource.data) || request.resource.data.id == bid) &&
             (!('code' in request.resource.data) || request.resource.data.code == bid);
    }

    function keepsOwnership() {
      return request.resource.data.iletisim.sahipUid == request.auth.uid &&
             (!('ownerUid' in request.resource.data) || request.resource.data.ownerUid == request.auth.uid) &&
             (!('sahipUid' in request.resource.data) || request.resource.data.sahipUid == request.auth.uid);
    }

    match /superadmin/{adminId} {
      allow read: if isSuperadmin();
      allow write: if false;
    }

    match /config/{doc} {
      allow read: if isAuthenticated();
      allow write: if isSuperadmin();
    }

    match /businesses/{bid} {
      allow read: if isSuperadmin() ||
                     isBusinessOwner(bid) ||
                     isBusinessStaff(bid);

      allow create: if isSuperadmin() || createsOwnBusiness(bid);

      allow update: if isSuperadmin() ||
                       (isBusinessOwner(bid) && keepsOwnership());

      allow delete: if isSuperadmin();

      match /publicSummary/{doc} {
        allow read: if isAuthenticated();
        allow write: if isSuperadmin() || isBusinessOwner(bid);
      }

      match /menu/{itemId} {
        allow read: if isAuthenticated();
        allow write: if isBusinessOwner(bid) ||
                        hasPermission(bid, 'menuDuzenle') ||
                        hasPermission(bid, 'menuManage');
      }

      match /categories/{catId} {
        allow read: if isAuthenticated();
        allow write: if isBusinessOwner(bid) ||
                        hasPermission(bid, 'menuDuzenle') ||
                        hasPermission(bid, 'menuManage');
      }

      match /tables/{tableId} {
        allow read: if isAuthenticated();
        allow write: if isBusinessOwner(bid) ||
                        hasPermission(bid, 'personelYonet') ||
                        hasPermission(bid, 'tablesManage');
      }

      match /stations/{stationId} {
        allow read: if (isBusinessOwner(bid) || isBusinessStaff(bid)) && !isSuperadmin();
        allow write: if isBusinessOwner(bid);
      }

      match /staff/{staffId} {
        allow read: if isBusinessOwner(bid) ||
                       (isBusinessStaff(bid) && !isSuperadmin());
        allow write: if isBusinessOwner(bid) ||
                        hasPermission(bid, 'personelYonet') ||
                        hasPermission(bid, 'staffManage');
      }

      match /orders/{orderId} {
        allow read: if !isSuperadmin() &&
                       isAuthenticated() &&
                       (isBusinessStaff(bid) ||
                        resource.data.musteri.id == request.auth.uid);

        allow create: if isAuthenticated() && !isSuperadmin() &&
                         request.resource.data.businessId == bid;

        allow update: if isBusinessStaff(bid) && !isSuperadmin();
        allow delete: if false;
      }

      match /orders_archive/{orderId} {
        allow read: if !isSuperadmin() &&
                       (isBusinessOwner(bid) ||
                        hasPermission(bid, 'raporGor') ||
                        hasPermission(bid, 'reportsView'));
        allow write: if false;
      }

      match /calls/{callId} {
        allow read: if isBusinessStaff(bid) && !isSuperadmin();
        allow create: if isAuthenticated() && !isSuperadmin();
        allow update: if isBusinessStaff(bid) && !isSuperadmin();
        allow delete: if false;
      }

      match /campaigns/{campId} {
        allow read: if isAuthenticated() && !isSuperadmin();
        allow write: if isBusinessOwner(bid) ||
                        hasPermission(bid, 'kampanyaOlustur');
      }

      match /stampCards/{cardId} {
        allow read: if isAuthenticated() && !isSuperadmin();
        allow write: if isBusinessOwner(bid) ||
                        hasPermission(bid, 'kampanyaOlustur');
      }

      match /loyalty/{doc} {
        allow read: if isAuthenticated() && !isSuperadmin();
        allow write: if isBusinessOwner(bid) ||
                        hasPermission(bid, 'kampanyaOlustur');
      }

      match /customerBusinesses/{customerId} {
        allow read: if isBusinessStaff(bid) && !isSuperadmin();
        allow write: if false;
      }

      match /activity/{eventId} {
        allow read: if !isSuperadmin() &&
                       (isBusinessOwner(bid) ||
                        hasPermission(bid, 'raporGor') ||
                        hasPermission(bid, 'reportsView'));
        allow write: if false;
      }

      match /metrics/{date} {
        allow read: if !isSuperadmin() &&
                       (isBusinessOwner(bid) ||
                        hasPermission(bid, 'raporGor') ||
                        hasPermission(bid, 'reportsView'));
        allow write: if false;
      }
    }

    match /customers/{cid} {
      allow read: if isCustomer(cid);
      allow create: if isCustomer(cid);
      allow update: if isCustomer(cid);
      allow delete: if false;

      match /cheques/{chqId} {
        allow read: if isCustomer(cid);
        allow create: if false;
        allow update: if isAuthenticated() && !isSuperadmin();
      }

      match /stamps/{stampId} {
        allow read: if isCustomer(cid);
        allow write: if false;
      }

      match /orders_history/{orderId} {
        allow read: if isCustomer(cid);
        allow write: if false;
      }

      match /notifications/{notifId} {
        allow read: if isCustomer(cid);
        allow write: if false;
      }
    }

    match /supportTickets/{ticketId} {
      allow read: if isSuperadmin() ||
                     (isAuthenticated() &&
                      resource.data.acanUid == request.auth.uid);

      allow create: if isAuthenticated();
      allow update: if isSuperadmin() ||
                       (isAuthenticated() &&
                        resource.data.acanUid == request.auth.uid);
      allow delete: if false;

      match /messages/{msgId} {
        allow read: if isSuperadmin() ||
                       (isAuthenticated() &&
                        get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.acanUid == request.auth.uid);
        allow create: if isAuthenticated();
        allow update, delete: if false;
      }
    }

    match /auditLog/{eventId} {
      allow read: if isSuperadmin();
      allow create: if false;
      allow update, delete: if false;
    }
  }
}
